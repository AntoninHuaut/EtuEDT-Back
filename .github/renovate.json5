// Renovate keeps Go modules, the Dockerfile base images and the workflows'
// actions current. It replaces Dependabot, which opened one PR per Docker
// image and per action on top of its gomod group.
//
// Every merge to master publishes the :master image that the homelab pins by
// digest, so routine bumps (minor, patch, digest) arrive together in one PR a
// week: one merge, one image. Majors stay one PR each so they can be tested
// and reverted on their own.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // best-practices adds, on top of config:recommended: actions and Docker
  // base images pinned to digests, config migration PRs and abandoned-module
  // warnings on the dashboard. Indirect modules are otherwise never looked
  // up, so a CVE in golang.org/x/crypto (indirect here) would go unpatched:
  // gomodIndirectSecurityUpdates opens PRs for those on vulnerability only.
  extends: ["config:best-practices", "security:gomodIndirectSecurityUpdates"],
  timezone: "Europe/Paris",
  schedule: ["* 7-12 * * 6"],
  labels: ["dependencies"],
  semanticCommits: "enabled",
  semanticCommitType: "chore",
  semanticCommitScope: "deps",
  // Security PRs already skip the Saturday schedule and the release-age
  // wait. OSV adds a second advisory source next to GitHub's, which often
  // lists a fix first. Still flagged experimental upstream (#20542).
  osvVulnerabilityAlerts: true,
  // Renovate updates go.sum but leaves stale entries and indirect requires
  // behind; tidy leaves the files as a local `go mod tidy` would.
  // A module major (retry-go/v4 -> /v5) is a new import path: without the
  // rewrite, Renovate only adds the /v5 require next to /v4, the code still
  // imports /v4, and it skips tidy for majors, so the PR changes nothing.
  postUpdateOptions: ["gomodTidy", "gomodUpdateImportPaths"],
  packageRules: [
    {
      groupName: "routine updates",
      groupSlug: "routine",
      matchUpdateTypes: ["minor", "patch", "digest"],
    },
    {
      // docker-compose.yml runs this repo's own image. Every merge publishes
      // a new :master digest, so tracking it here would open a PR whose merge
      // publishes the next digest, forever. The homelab pins it instead.
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/antoninhuaut/etuedt-back"],
      enabled: false,
    },
  ],
}
